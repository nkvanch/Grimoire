# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Environment files (contain API keys — never commit)
.env

# dependencies
node_modules/
# the hosted web build keeps its assets (icons and the SQLite wasm) in a folder that is named node_modules
!docs/app/assets/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Downloaded EAS build artifacts
builds/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# graphify knowledge graph (generated, rebuild with `graphify update .`)
graphify-out/
.claude/settings.json.graphify-bak

# jest coverage reports (generated, rerun `jest --coverage` to regenerate)
/coverage

# creator outreach drafts (private)
outreach/private/
outreach/to-send/

# Generated first-party packs (scripts/build-srd-packs.ts)
/release/
# the private build copies its non-SRD packs here (scripts/build-apk-local.ps1); never committed
/assets/packs/private/

# Device UI dumps and screenshots taken while debugging (adb uiautomator), and one-off edit scripts
/*.xml
/*.png
/scripts/_*

# Another creator's homebrew PDFs (local reference only) and screen recordings
/docs/homebrew/Zell/
*.mp4

# Obsidian: personal window state and downloaded plugins
/.obsidian/workspace.json
/.obsidian/plugins/
# written by scripts/extract-srd-items.py next to items.json, with the same content
/third_party/wotc/srd/5.1/extracted/items.raw.json
